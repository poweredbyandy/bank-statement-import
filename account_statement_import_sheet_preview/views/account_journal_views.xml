<odoo>
    <record id="view_account_journal_form_sheet_preview" model="ir.ui.view">
        <field name="name">account.journal.form.sheet.preview</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_statement_import_sheet_file.view_account_journal_form_n43"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//group[field[@name='default_sheet_mapping_id']]"
                position="replace"
            >
                <group string="Formatos de archivo bancario" invisible="type != 'bank'">
                    <field
                        name="sheet_mapping_ids"
                        string="Formatos disponibles"
                        widget="many2many_tags"
                        options="{'no_create_edit': False}"
                        placeholder="Formatos guardados para este diario"
                    />
                    <field
                        name="default_sheet_mapping_id"
                        string="Último formato usado"
                        domain="[('id', 'in', sheet_mapping_ids)]"
                        help="Se usará por defecto la próxima vez que importe un extracto."
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
